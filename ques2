#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node* next;
};

struct Node* mergeSortedLists(struct Node* L1, struct Node* L2) {
    struct Node dummy;
    struct Node* tail = &dummy;
    dummy.next = NULL;

    while (L1 != NULL && L2 != NULL) {
        if (L1->data <= L2->data) {
            tail->next = L1;
            L1 = L1->next;
        } else {
            tail->next = L2;
            L2 = L2->next;
        }
        tail = tail->next;
    }

    if (L1 != NULL) {
        tail->next = L1;
    } else {
        tail->next = L2;
    }

    return dummy.next;
}
