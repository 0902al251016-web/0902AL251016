#include <stdio.h>

int findMissingNumber(int arr[], int size) {
    int n = size + 1;

    int xor1 = 0;
    int xor2 = 0;

    for (int i = 1; i <= n; i++) {
        xor1 ^= i;
    }

    for (int i = 0; i < size; i++) {
        xor2 ^= arr[i];
    }

    return xor1 ^ xor2;
}

int main() {
    int arr[] = {1, 2, 4, 5, 6};
    int size = sizeof(arr) / sizeof(arr[0]);

    int missing = findMissingNumber(arr, size);

    printf("Array elements: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }

    printf("\nMissing number: %d\n", missing);

    return 0;
}